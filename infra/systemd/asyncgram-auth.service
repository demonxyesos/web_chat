[Unit]
Description=Asyncgram Auth Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/chat
EnvironmentFile=/opt/chat/.env
Environment=PYTHONPATH=/opt/chat:/opt/chat/packages/common
ExecStart=/opt/chat/venv/bin/uvicorn services.auth_service.app.main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
