[Unit]
Description=Asyncgram Admin Service
After=network.target postgresql.service redis.service asyncgram-auth.service asyncgram-chat.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/chat
EnvironmentFile=/opt/chat/.env
Environment=PYTHONPATH=/opt/chat:/opt/chat/packages/common
ExecStart=/opt/chat/venv/bin/uvicorn services.admin_service.app.main:app --host 127.0.0.1 --port 8005
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
